<?xml version="1.0" encoding="utf-8"?>
<!-- Skeuomorphic Heavy Red Mechanical Plunger / Test Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Depressed plunger -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Dark recessed socket -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#050505" />
                </shape>
            </item>
            <item android:top="3dp" android:left="2dp" android:right="2dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#641E16"
                        android:centerColor="#922B21"
                        android:endColor="#B03A2E" />
                    <stroke android:width="2dp" android:color="#4A1510" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal state: Raised convex ruby button with metallic bezel -->
    <item>
        <layer-list>
            <!-- Outer shadow on faceplate -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#08090C" />
                </shape>
            </item>
            <!-- Metallic Bezel ring -->
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#7F8C8D"
                        android:centerColor="#34495E"
                        android:endColor="#1B2631" />
                </shape>
            </item>
            <!-- Red Plunger Core with Specular Top Rim -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#E74C3C"
                        android:centerColor="#C0392B"
                        android:endColor="#7B241C" />
                    <stroke android:width="1.5dp" android:color="#F1948A" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
